diff --git a/src/agx_arm_moveit/config/agx_arm.srdf.xacro b/src/agx_arm_moveit/config/agx_arm.srdf.xacro
index a9a384b..7ac5812 100644
--- a/src/agx_arm_moveit/config/agx_arm.srdf.xacro
+++ b/src/agx_arm_moveit/config/agx_arm.srdf.xacro
@@ -7,6 +7,26 @@
   <xacro:property name="arm_type" value="$(arg arm_type)" />
   <xacro:property name="flange_link" value="${'link7' if arm_type == 'nero' else 'link6'}" />
 
+  <!-- Neighbouring Revo2 fingers move side by side and never touch, but their meshes sit
+       3-10 mm apart. Left enabled, they keep MoveIt Servo's self-collision slowdown on. -->
+  <xacro:macro name="revo2_neighbor_fingers" params="side a b">
+    <disable_collisions link1="${side}_${a}_proximal_link" link2="${side}_${b}_proximal_link" reason="Never" />
+    <disable_collisions link1="${side}_${a}_proximal_link" link2="${side}_${b}_distal_link" reason="Never" />
+    <disable_collisions link1="${side}_${a}_proximal_link" link2="${side}_${b}_touch_link" reason="Never" />
+    <disable_collisions link1="${side}_${a}_distal_link" link2="${side}_${b}_proximal_link" reason="Never" />
+    <disable_collisions link1="${side}_${a}_distal_link" link2="${side}_${b}_distal_link" reason="Never" />
+    <disable_collisions link1="${side}_${a}_distal_link" link2="${side}_${b}_touch_link" reason="Never" />
+    <disable_collisions link1="${side}_${a}_touch_link" link2="${side}_${b}_proximal_link" reason="Never" />
+    <disable_collisions link1="${side}_${a}_touch_link" link2="${side}_${b}_distal_link" reason="Never" />
+    <disable_collisions link1="${side}_${a}_touch_link" link2="${side}_${b}_touch_link" reason="Never" />
+  </xacro:macro>
+  <xacro:macro name="revo2_hand_extra_disables" params="side">
+    <xacro:revo2_neighbor_fingers side="${side}" a="index" b="middle" />
+    <xacro:revo2_neighbor_fingers side="${side}" a="middle" b="ring" />
+    <xacro:revo2_neighbor_fingers side="${side}" a="ring" b="pinky" />
+    <disable_collisions link1="flange_link" link2="${side}_thumb_metacarpal_link" reason="Never" />
+  </xacro:macro>
+
   <!-- ======================== ARM GROUP ======================== -->
   <group name="arm">
     <chain base_link="base_link" tip_link="tcp_link" />
@@ -105,6 +125,7 @@
     <passive_joint name="left_ring_distal_joint" />
     <passive_joint name="left_pinky_distal_joint" />
     <!-- Left hand disable collisions -->
+    <xacro:revo2_hand_extra_disables side="left" />
     <disable_collisions link1="left_base_link" link2="left_index_distal_link" reason="Never" />
     <disable_collisions link1="left_base_link" link2="left_index_proximal_link" reason="Adjacent" />
     <disable_collisions link1="left_base_link" link2="left_index_touch_link" reason="Never" />
@@ -246,6 +267,7 @@
     <passive_joint name="right_ring_distal_joint" />
     <passive_joint name="right_pinky_distal_joint" />
     <!-- Right hand disable collisions -->
+    <xacro:revo2_hand_extra_disables side="right" />
     <disable_collisions link1="right_base_link" link2="right_index_distal_link" reason="Never" />
     <disable_collisions link1="right_base_link" link2="right_index_proximal_link" reason="Adjacent" />
     <disable_collisions link1="right_base_link" link2="right_index_touch_link" reason="Never" />
@@ -357,6 +379,45 @@
     </group_state>
   </xacro:if>
 
+  <!-- ======================== READY STATE ======================== -->
+  <!-- Elbow bent, tool pointing straight down. "home" (all zeros) is a singular pose where
+       MoveIt Servo refuses Cartesian commands; start teleop from here instead.
+       Jacobian condition number ~10-11 on every arm, well below Servo's threshold of 100. -->
+  <xacro:if value="$(eval arm_type in ['piper', 'piper_l', 'piper_h'])">
+    <!-- tcp ~(0.25, 0, 0.21) m on piper -->
+    <group_state name="ready" group="arm">
+      <joint name="joint1" value="0" />
+      <joint name="joint2" value="1.5" />
+      <joint name="joint3" value="-0.9" />
+      <joint name="joint4" value="0" />
+      <joint name="joint5" value="1.0" />
+      <joint name="joint6" value="0" />
+    </group_state>
+  </xacro:if>
+  <xacro:if value="$(eval arm_type == 'piper_x')">
+    <!-- piper_x wrist pitches about joint4, not joint5; tcp ~(0.27, 0, 0.18) m -->
+    <group_state name="ready" group="arm">
+      <joint name="joint1" value="0" />
+      <joint name="joint2" value="1.5" />
+      <joint name="joint3" value="-0.9" />
+      <joint name="joint4" value="1.0" />
+      <joint name="joint5" value="0" />
+      <joint name="joint6" value="0" />
+    </group_state>
+  </xacro:if>
+  <xacro:if value="$(eval arm_type == 'nero')">
+    <!-- nero works toward -x (see test/nero/test_move_p.yaml); tcp ~(-0.30, 0, 0.42) m -->
+    <group_state name="ready" group="arm">
+      <joint name="joint1" value="0" />
+      <joint name="joint2" value="0.1" />
+      <joint name="joint3" value="0" />
+      <joint name="joint4" value="1.5" />
+      <joint name="joint5" value="-1.5708" />
+      <joint name="joint6" value="0" />
+      <joint name="joint7" value="0" />
+    </group_state>
+  </xacro:if>
+
   <!-- ======================== ARM DISABLE COLLISIONS ======================== -->
   <disable_collisions link1="base_link" link2="link1" reason="Adjacent" />
   <disable_collisions link1="base_link" link2="link2" reason="Never" />
